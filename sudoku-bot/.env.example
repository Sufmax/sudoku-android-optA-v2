# Copie ce fichier en .env (cp .env.example .env) puis adapte les valeurs.

# Mot de passe UNIQUE : dashboard Cloudflare (même valeur que le secret Worker
# DASHBOARD_PASSWORD) + noVNC (8 premiers caractères, limite du protocole VNC).
DASHBOARD_PASSWORD=change-moi-par-un-long-mot-de-passe

# URL WebSocket du Worker (après `npx wrangler deploy`). Vide = dashboard désactivé.
DASHBOARD_URL=wss://sudoku-hub.<ton-compte>.workers.dev/ws/bot

# Identifiant de cette machine dans le dashboard
MACHINE_ID=csb-01

# --- Émulateur (optionnel : sinon config/config.yaml fait foi) -----------------
# Variante d'image : playstore (Google Play natif) | aurora (AOSP + Aurora Store)
#IMAGE_VARIANT=playstore
# Accélération : auto | on | off
#EMULATOR_ACCEL=auto
# Backend : auto (= émulateur local) | avd | remote | redroid
#ANDROID_BACKEND=auto
# Backend remote uniquement :
#REMOTE_ADB_SERIAL=127.0.0.1:5555
